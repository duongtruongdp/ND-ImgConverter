{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ND Image Converter",
  "version": "0.9.0",
  "identifier": "com.nd.imageconverter",
  "build": {
    "beforeDevCommand": "npm run prepare:ytdlp-pot && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ND Image Converter",
        "width": 1050,
        "height": 700,
        "minWidth": 820,
        "minHeight": 550,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**",
          "$TEMP/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "binaries/ffmpeg",
      "binaries/ffprobe",
      "binaries/yt-dlp",
      "binaries/gallery-dl",
      "binaries/bgutil-pot",
      "binaries/yt-dlp-plugins",
      "binaries/lib",
      "resources/FFMPEG-NOTICES.txt",
      "resources/GALLERY-DL-NOTICES.txt",
      "resources/MEDIA-ENGINE-NOTICES.txt",
      "binaries/gallery-dl-build.json",
      "binaries/runtime-manifest.json"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "12.3",
      "dmg": {
        "background": "icons/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 200
        }
      }
    },
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/128x128.png"
      }
    }
  }
}
