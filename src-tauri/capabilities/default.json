{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-start-dragging",
    "dialog:default",
    "fs:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/duongtruongdp/ND-ImgConverter" },
        { "url": "https://github.com/duongtruongdp/ND-ImgConverter/releases/*" }
      ]
    }
  ]
}
